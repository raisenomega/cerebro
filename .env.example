# CEREBRO — variables de entorno (ejemplo). NUNCA pongas valores reales aquí.
# Los valores reales van al Vault (Railway Variables / Supabase Secrets), jamás al repo.

# --- Supabase propio dedicado de CEREBRO ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Conexión a Postgres (POOLER de Supabase, NO conexión directa) ---
# Rol de login MIEMBRO de cerebro_api (SIN BYPASSRLS): la identidad se aísla por
# RLS en la base, no en el código; el resolver NUNCA usa service_role. La API
# fija SET LOCAL app.current_owner_id por request. Usa el POOLER (session mode,
# :5432), no el host directo db.<ref>.supabase.co. Password en el Vault.
# Ej.: postgresql://<rol>.<project-ref>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Voyage (embeddings) — modelo FIJO del ecosistema ---
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-large
VOYAGE_DIM=1024

# --- Anthropic (si CEREBRO necesitara razonar; normalmente no) ---
ANTHROPIC_API_KEY=

# --- Service tokens por plataforma (auth de la API de CEREBRO) ---
# El nombre tras CEREBRO_SERVICE_TOKEN_ es la source_platform (en minúsculas).
CEREBRO_SERVICE_TOKEN_HUB=
CEREBRO_SERVICE_TOKEN_NUCLEO=

# --- API HTTP ---
PORT=8080
