# CEREBRO — variables de entorno (ejemplo). NUNCA pongas valores reales aquí.
# Los valores reales van al Vault (Railway Variables / Supabase Secrets), jamás al repo.

# --- Supabase propio dedicado de CEREBRO ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Conexión directa del resolver de identidad (rol cerebro_api, SIN BYPASSRLS) ---
# La identidad se aísla por RLS en la base, no en el código: el resolver NUNCA
# usa service_role. Usa un rol de login MIEMBRO de cerebro_api (password en el
# Vault). La API fija SET LOCAL app.current_owner_id por request.
DATABASE_URL=

# --- Voyage (embeddings) — modelo FIJO del ecosistema ---
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-large
VOYAGE_DIM=1024

# --- Anthropic (si CEREBRO necesitara razonar; normalmente no) ---
ANTHROPIC_API_KEY=

# --- Service tokens por plataforma (auth de la API de CEREBRO) ---
CEREBRO_SERVICE_TOKEN_HUB=
CEREBRO_SERVICE_TOKEN_NUCLEO=
